# .env untuk production (cPanel)
# Ganti "cpaneluser" dengan username cPanel kamu (biasanya 8 karakter, cukup prefix sebelum _)

# Database (buat dulu di cPanel > MySQL Databases)
DB_HOST=localhost
DB_PORT=3306
DB_USER=cpaneluser_ppuser
DB_PASSWORD=PASSWORD_DB_YANG_KAMU_BUAT
DB_NAME=cpaneluser_ppalhikmah

# PORT diabaikan Passenger (otomatis diset cPanel), tetap 3000 untuk lokal
PORT=3000
